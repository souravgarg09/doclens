# Infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/docqa
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=regions

# Multimodal reasoner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.6-flash
GEMINI_THINKING=minimal

# Runtime
STORAGE_DIR=./data
TORCH_DEVICE=auto
RENDER_DPI=144
EMBEDDING_BATCH_SIZE=16
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25

# Retrieval and verification
GROUNDING_THRESHOLD=0.35
TOP_K_RETRIEVE=20
TOP_K_CONTEXT=6
MAX_VERIFY_ATTEMPTS=2

# Performance
CUDA_FP16=true
PRELOAD_MODELS=true
LEXICAL_WEIGHT=1.0
GEMINI_RERANK=false
GEMINI_HEDGE_AFTER_S=6
